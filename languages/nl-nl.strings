%{ About - FrogFind %}
"about_what_is_t" = "Wat is FrogFind?";
"about_faq_short_description" = "Een korte FAQ over een ongewone zoekmachine";
"about_who_made_q" = "Wie heeft FrogFind gemaakt?";
"about_who_made_a" = "Hoi, ik ben Sean, ook bekend als <a href=\"https://youtube.com/ActionRetro\">Action Retro</a> op YouTube. Ik werk veel met Macs uit de jaren 80 en 90 (en andere oude computers), en ik probeer ze graag online te krijgen. Het moderne internet is helaas niet vriendelijk voor oude machines. Basiswebsites werken echter prima. Dus besloot ik zoveel mogelijk van het internet om te zetten naar eenvoudige HTML!";
"about_how_does_q" = "Hoe werkt FrogFind?";
"about_how_does_a" = "De zoekfunctie van FrogFind is een wrapper voor SearXNG, die de resultaten omzet naar zeer eenvoudige HTML die oude browsers kunnen lezen. Pagina's worden verwerkt via een <a href=\"https://github.com/fivefilters/readability.php\">PHP-versie van Mozilla's Readability</a>, de motor achter de leesmodus van Firefox.";
"about_what_machines_do_you_test_q" = "Op welke machines test je FrogFind?";
"about_what_machines_do_you_test_a" = "FrogFind is ontworpen met klassieke Macs in gedachten, getest op een SE/30 met 1-bit kleur en 512x384 resolutie. Voornamelijk getest op Netscape 1.1N en 2.0.2. FrogFind werkt ook prima op tekstgebaseerde browsers!";
"about_how_can_i_get_in_touch_q" = "Hoe kan ik contact opnemen?";
"about_how_can_i_get_in_touch_a" = "Stuur een e-mail naar <a href=\"mailto:actionretro@pm.me\">actionretro@pm.me</a>.";

%{ About - FrogFindPlus (Tinelix) %}
"about_what_is_frogfindplus_t" = "Wat is FrogFindPlus?";
"about_frogfindplus_whats_difference_q" = "Wat is het verschil tussen FrogFindPlus en het originele FrogFind?";
"about_frogfindplus_whats_difference_a" = "FrogFindPlus is een fork van het originele FrogFind door Action Retro, gemaakt door <a href=\"http://tinelix.ru\">Tinelix</a>. Het voegt meertalige ondersteuning toe en diverse verbeteringen.";
"about_frogfindplus_who_translated_q" = "Wie heeft FrogFind vertaald?";
"about_frogfindplus_who_translated_a" = "FrogFind is gedeeltelijk vertaald door Vladimir Barinov, ook bekend als <a href=\"http://veselcraft.ru\">Veselcraft</a>.";
"about_frogfindplus_does_have_source_q" = "Heeft FrogFindPlus broncode?";
"about_frogfindplus_does_have_source_a" = "Ja! De broncode staat op GitHub: <a href=\"https://github.com/tinelix/FrogFindPlus\">github.com/tinelix/FrogFindPlus</a>.";

%{ About - FrogFindPlusPlus (deze fork) %}
"about_what_is_frogfindplusplus_t" = "Wat is FrogFindPlusPlus?";
"about_frogfindplusplus_whats_difference_q" = "Wat is het verschil tussen FrogFindPlusPlus en FrogFindPlus?";
"about_frogfindplusplus_whats_difference_a" = "FrogFindPlusPlus is een fork van FrogFindPlus (dat zelf een fork is van het originele FrogFind). De belangrijkste aanpassing is dat DuckDuckGo vervangen is door een zelf-gehoste SearXNG instantie als zoekbackend, voor meer controle over zoekresultaten en privacy. Ook is Nederlandse taalondersteuning toegevoegd.";
"about_frogfindplusplus_does_have_source_q" = "Heeft FrogFindPlusPlus broncode?";
"about_frogfindplusplus_does_have_source_a" = "Ja! Je vindt hem op GitHub: <a href=\"https://github.com/Henkdetenk12345/FrogFindPlusPlus\">github.com/Henkdetenk12345/FrogFindPlusPlus</a>.";

